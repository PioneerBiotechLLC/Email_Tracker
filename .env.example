# ======================================================================
# Where each variable is needed:  [P] Vercel Production   [L] local / laptop CLI
# ======================================================================

# ---- Database (Neon) ---- [P][L]
# App connection: Neon POOLED string (…-pooler.…neon.tech). Local: filled by `pnpm db:local`.
DATABASE_URL=postgresql://user:password@host:5432/email_tracker
# Migrations (`pnpm db:deploy`): Neon DIRECT string (no -pooler). [L] (and [P] if you ever migrate from Vercel — not recommended)
DIRECT_URL=

# ---- Microsoft Graph (multi-tenant app-only / client credentials) ---- [P][L]
# Default tenant for the CLI (`pnpm mailbox add` without --tenant); companies keep their own tenant id.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Random secret Graph echoes in every notification (`openssl rand -hex 32`) [P]
GRAPH_CLIENT_STATE=
# Optional override; by default derived from APP_URL as <APP_URL>/api/graph/webhook
GRAPH_WEBHOOK_URL=

# ---- Claude API (thread summaries) ----
ANTHROPIC_API_KEY=
# Main model for summaries (current Sonnet). Opus (claude-opus-5-5) is stronger but 2x the price.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional cheaper model for very short threads (1–2 short messages). Leave empty to always use ANTHROPIC_MODEL.
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5
# Hard cap on Claude calls per organization per day (live + batch). Remaining threads wait for the next run.
AI_MAX_CALLS_PER_DAY=500
# Wait this many minutes after a thread's last message before summarizing it (a burst → one call)
AI_SUMMARY_DEBOUNCE_MINUTES=2
# Reasoning effort (low | medium | high). low is plenty for summaries and cheapest.
AI_EFFORT=low

# ---- Ask (chat over emails) ---- [P][L]
# Off by default: no "Ask" menu entry and its routes return 404. Before switching it on in production:
# pnpm db:deploy, pnpm search:reindex, pnpm search:backfill-links (README, "Ask (chat)").
CHAT_ENABLED=false
# Model that answers questions, and the one used when the user ticks "Deep answer" (about 2x the price)
ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5
ANTHROPIC_CHAT_DEEP_MODEL=claude-opus-5-5
# Questions one user may ask per day. Every Claude call of a question also counts toward AI_MAX_CALLS_PER_DAY.
AI_CHAT_MAX_QUESTIONS_PER_USER_PER_DAY=50

# ---- Sync / tracking ----
BACKFILL_DAYS=90
REPLY_SLA_HOURS=24

# ---- Digest (Phase 6) ----
DIGEST_FROM_MAILBOX=tracker@api-pharma.net

# ---- Security ----
# 32 random bytes, base64: `openssl rand -base64 32`. If empty, bodies are stored in plaintext.
DATA_ENCRYPTION_KEY=

# ---- Deployment ---- [P]
# Public URL of the deployed dashboard (no trailing slash). Webhooks + admin-consent callback are derived from it.
APP_URL=
# Bearer secret for /api/cron/* (`openssl rand -hex 32`); also a GitHub Actions secret
CRON_SECRET=
# Storage indicator on the Companies page (Neon free = 512)
DB_STORAGE_LIMIT_MB=512

# ---- Dashboard (apps/web) ---- [P][L]
# `openssl rand -base64 32`
AUTH_SECRET=
# Entra app registration used for dashboard sign-in (see README §6). Can be the same app as above
# with a web redirect URI added, or a separate one.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Multi-tenant login (any company tenant): https://login.microsoftonline.com/organizations/v2.0 (default when empty)
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Public URL of the dashboard in production (used for the OAuth callback), e.g. https://tracker.api-pharma.net
AUTH_URL=
# Dev server on the office network: `pnpm dev:lan` binds to all interfaces; list the IPs/hostnames colleagues will type here
DEV_ALLOWED_ORIGINS=192.168.70.96,mohameds-macbook-air.local
# Playwright only: with NODE_ENV=test, sign in as this AppUser without Microsoft. Never set in production.
# E2E_BYPASS_EMAIL=demo-admin@demo-pharma.example

LOG_LEVEL=info
