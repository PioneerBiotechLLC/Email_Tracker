# ---- Database (Postgres: Supabase / Neon / local) ----
# Use a direct (non-pooled) connection string for migrations.
DATABASE_URL=postgresql://user:password@host:5432/email_tracker

# ---- Microsoft Graph (app-only / client credentials) ----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Phase 5 (live sync)
GRAPH_WEBHOOK_URL=https://<web-domain>/api/graph/webhook
GRAPH_CLIENT_STATE=<random secret>

# ---- Claude API (thread summaries) ----
ANTHROPIC_API_KEY=
# Main model for summaries (current Sonnet). Opus (claude-opus-5-5) is stronger but 2x the price.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional cheaper model for very short threads (1–2 short messages). Leave empty to always use ANTHROPIC_MODEL.
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5
# Hard cap on Claude calls per organization per day (live + batch). Remaining threads wait for the next run.
AI_MAX_CALLS_PER_DAY=500
# Wait this many minutes after a thread's last message before summarizing it (a burst → one call)
AI_SUMMARY_DEBOUNCE_MINUTES=2
# Reasoning effort (low | medium | high). low is plenty for summaries and cheapest.
AI_EFFORT=low

# ---- Sync / tracking ----
BACKFILL_DAYS=90
REPLY_SLA_HOURS=24

# ---- Digest (Phase 6) ----
DIGEST_FROM_MAILBOX=tracker@api-pharma.net

# ---- Security ----
# 32 random bytes, base64: `openssl rand -base64 32`. If empty, bodies are stored in plaintext.
DATA_ENCRYPTION_KEY=

# ---- Dashboard auth (Phase 4) ----
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

LOG_LEVEL=info
