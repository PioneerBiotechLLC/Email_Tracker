{
  "name": "email-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "db:generate": "pnpm --filter @email-tracker/core db:generate",
    "db:migrate": "pnpm --filter @email-tracker/core db:migrate",
    "db:deploy": "pnpm --filter @email-tracker/core db:deploy",
    "db:push": "pnpm --filter @email-tracker/core db:push",
    "db:studio": "pnpm --filter @email-tracker/core db:studio",
    "mailbox": "pnpm --filter @email-tracker/worker mailbox",
    "sync:once": "pnpm --filter @email-tracker/worker sync:once",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "replies:recompute": "pnpm --filter @email-tracker/worker replies recompute",
    "replies:report": "pnpm --filter @email-tracker/worker replies report",
    "ai:backfill": "pnpm --filter @email-tracker/worker ai backfill",
    "ai:summarize": "pnpm --filter @email-tracker/worker ai summarize",
    "ai:summarize-thread": "pnpm --filter @email-tracker/worker ai summarize-thread",
    "ai:usage": "pnpm --filter @email-tracker/worker ai usage",
    "dev": "pnpm --filter @email-tracker/web dev",
    "build": "pnpm --filter @email-tracker/web build",
    "start": "pnpm --filter @email-tracker/web start",
    "test:e2e": "pnpm --filter @email-tracker/web test:e2e",
    "user": "pnpm --filter @email-tracker/worker user",
    "db:seed-demo": "pnpm --filter @email-tracker/core seed-demo"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
