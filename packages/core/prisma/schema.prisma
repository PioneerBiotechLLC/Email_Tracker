// Outlook AI Email Tracker — data model (SPEC.md §4)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum ThreadStatus {
  awaiting_us
  awaiting_them
  no_reply_needed
  closed
}

enum ThreadCategory {
  customer
  supplier
  internal
  regulatory
  finance
  newsletter
  notification
  other
}

enum Priority {
  low
  normal
  high
  urgent
}

enum Direction {
  inbound
  outbound
}

enum MailFolder {
  inbox
  sent
  other
}

enum ReplyMethod {
  outlook_verb
  header_match
  conversation_match
}

enum UserRole {
  admin
  viewer
}

/// Who made a needs-reply / close decision
enum DecisionSource {
  user
  ai
}

/// How much of each email body is kept in our database
enum BodyStorage {
  full
  preview_only
}

/// What an exclusion rule matches on
enum ExclusionRuleType {
  sender_email
  sender_domain
  subject_contains
  subject_regex
}

/// ignore = stored but hidden everywhere by default; no_reply_needed = shown, never counted as awaiting/overdue.
/// Neither is ever sent to the AI.
enum ExclusionAction {
  ignore
  no_reply_needed
}

/// What a Claude API call was for (cost reporting)
enum AiPurpose {
  summary
  period_summary
  chat
}

/// Window covered by an AI period summary (rolling: today / last 7 days / last 30 days)
enum SummaryPeriod {
  day
  week
  month
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  /// URL slug: /c/<slug>/…
  slug            String   @unique
  /// Primary email domain (also used as the org key in the CLI)
  domain          String   @unique
  /// Additional email domains that count as this company
  domains         String[] @default([])
  /// Microsoft 365 tenant. Null until "Connect Microsoft 365" (admin consent) records it.
  azureTenantId   String?
  consentGrantedAt DateTime?
  timezone        String   @default("Asia/Dubai")
  /// Working days, 0 = Sunday … 6 = Saturday. Default Sun–Thu.
  workDays        Int[]    @default([0, 1, 2, 3, 4])
  /// Local wall-clock "HH:MM"
  workStart       String   @default("09:00")
  workEnd         String   @default("18:00")
  /// Overrides REPLY_SLA_HOURS for this org when set (business hours)
  replySlaHours   Float?
  summaryLanguage String   @default("en")
  /// Branding for the dashboard
  logoUrl         String?
  primaryColor    String   @default("#BE272C")
  secondaryColor  String   @default("#BE6B27")
  /// Font keys understood by the web app (merriweather | playfair | inter; source-sans | inter | noto-sans)
  headingFont     String   @default("merriweather")
  bodyFont        String   @default("source-sans")
  /// Company context injected into the AI summary system prompt
  aiContext       String?
  /// full = cleaned body text (encrypted when a key is set); preview_only = first ~500 chars only
  bodyStorage     BodyStorage @default(full)
  /// Rows older than this are purged from OUR database by the retention job (never from the mailbox)
  retentionDays   Int      @default(365)
  /// Daily digest (sent in Phase 6): recipients and local send time
  digestRecipients String[] @default([])
  digestHour      Int      @default(8)
  digestMinute    Int      @default(0)
  /// Demo organizations are created by `pnpm db:seed-demo` and can be removed with --remove
  isDemo          Boolean  @default(false)
  /// Free-form org settings
  settings        Json     @default("{}")
  createdAt       DateTime @default(now())

  mailboxes   Mailbox[]
  memberships Membership[]
  digests     DigestLog[]
  aiUsage     AiUsage[]
  auditLogs   AuditLog[]
  periodSummaries PeriodSummary[]
  exclusionRules  ExclusionRule[]
  chatSessions    ChatSession[]
}

model Mailbox {
  id                    String    @id @default(cuid())
  orgId                 String
  org                   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  emailAddress          String    @unique
  /// Other addresses that count as "us" for this mailbox (proxy addresses / aliases), lowercase.
  aliases               String[]  @default([])
  displayName           String?
  graphUserId           String
  isActive              Boolean   @default(true)
  inboxDeltaLink        String?
  sentDeltaLink         String?
  subscriptionId        String?
  subscriptionExpiresAt DateTime?
  lastSyncedAt          DateTime?
  /// Last sync failure message (cleared on the next successful sync)
  lastSyncError         String?
  lastSyncErrorAt       DateTime?
  /// Set while a sync runs (webhook/cron); stale after 10 minutes
  syncLockedAt          DateTime?
  createdAt             DateTime  @default(now())

  threads  Thread[]
  messages Message[]
  periodSummaries PeriodSummary[]
  exclusionRules  ExclusionRule[]
}

/// Emails that should not be counted (account notifications, newsletters, system alerts).
/// Rules are never hard-deleted: deactivate them so the audit trail stays complete.
model ExclusionRule {
  id                  String            @id @default(cuid())
  orgId               String
  org                 Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// null = every mailbox of the company
  mailboxId           String?
  mailbox             Mailbox?          @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  type                ExclusionRuleType
  /// Address ("billing@godaddy.com", or "mailer-daemon@*" for any domain), domain, text or regular expression
  value               String
  /// Optional second condition, ANDed with the first: the subject must also contain this text
  andSubjectContains  String?
  action              ExclusionAction
  note                String?
  /// Set on the built-in default rules so `pnpm rules:seed-defaults` never re-creates one that was edited or deactivated
  defaultKey          String?
  createdBy           String
  createdAt           DateTime          @default(now())
  isActive            Boolean           @default(true)

  @@unique([orgId, defaultKey])
  @@index([orgId, isActive])
}

model Thread {
  id                  String         @id @default(cuid())
  mailboxId           String
  mailbox             Mailbox        @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  conversationId      String
  subject             String
  normalizedSubject   String
  firstMessageAt      DateTime
  lastMessageAt       DateTime
  messageCount        Int            @default(0)
  participants        Json           @default("[]")
  status              ThreadStatus   @default(awaiting_us)
  needsReply          Boolean        @default(true)
  category            ThreadCategory @default(other)
  priority            Priority       @default(normal)
  /// Set by hand in the dashboard; the AI must not overwrite these
  categoryManual      Boolean        @default(false)
  priorityManual      Boolean        @default(false)
  summary             String?
  summaryLang         String?
  keyPoints           Json?
  asks                Json?
  nextAction          String?
  summaryUpdatedAt    DateTime?
  summaryMessageCount Int            @default(0)
  summaryModel        String?
  /// Last summarization failure (validation / API error). Cleared on success.
  summaryError        String?
  /// Who last decided needsReply; null = undecided (default true until the AI runs)
  needsReplyDecidedBy DecisionSource?
  needsReplyDecidedAt DateTime?
  /// When status = awaiting_us: receivedAt of the oldest unanswered inbound message we are waiting to answer
  awaitingSince       DateTime?
  /// When status = awaiting_us: the instant the reply SLA expires (business-hours aware). Overdue ⇔ overdueAt <= now.
  overdueAt           DateTime?
  closedAt            DateTime?
  closedBy            String?
  /// Set when EVERY message of this thread is a copy (same Message-ID, e.g. we were CC'd) of messages in one
  /// thread of another mailbox in the same company. Copy threads are hidden from the "All mailboxes" views and
  /// inherit that thread's AI summary instead of being summarized again.
  duplicateOfId       String?
  duplicateOf         Thread?        @relation("DuplicateThread", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates          Thread[]       @relation("DuplicateThread")
  /// Set when EVERY inbound message of the thread is excluded: "ignore" when all of them are ignored, else
  /// "no_reply_needed". Such threads are never summarized by the AI.
  exclusionAction     ExclusionAction?
  /// Full-text search over subject + AI summary + key points + next action ('simple' config; written by app code)
  searchVector        Unsupported("tsvector")?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  messages Message[]

  @@index([searchVector], type: Gin)

  @@unique([mailboxId, conversationId])
  @@index([duplicateOfId])
  @@index([mailboxId, status])
  @@index([mailboxId, status, overdueAt])
  @@index([mailboxId, normalizedSubject])
  @@index([mailboxId, lastMessageAt])
}

model Message {
  id                      String      @id @default(cuid())
  mailboxId               String
  mailbox                 Mailbox     @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  threadId                String
  thread                  Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  conversationId          String
  /// Graph immutable message id
  graphMessageId          String      @unique
  internetMessageId       String?
  inReplyTo               String?
  references              String[]    @default([])
  direction               Direction
  folder                  MailFolder
  fromAddress             String
  fromName                String?
  toAddresses             Json        @default("[]")
  ccAddresses             Json        @default("[]")
  subject                 String
  receivedAt              DateTime
  sentAt                  DateTime?
  bodyPreview             String?
  /// Cleaned "new content only" text, capped at 8000 chars. Encrypted when bodyEncrypted = true.
  bodyText                String?
  bodyEncrypted           Boolean     @default(false)
  hasAttachments          Boolean     @default(false)
  importance              String      @default("normal")
  /// Out-of-office / auto-submitted message (not a real reply)
  isAutoReply             Boolean     @default(false)
  /// PidTagLastVerbExecuted: 102 reply, 103 reply-all, 104 forward
  lastVerb                Int?
  lastVerbAt              DateTime?
  repliedAt               DateTime?
  repliedByMessageId      String?
  repliedBy               Message?    @relation("ReplyLink", fields: [repliedByMessageId], references: [id], onDelete: SetNull)
  repliesTo               Message[]   @relation("ReplyLink")
  replyMethod             ReplyMethod?
  /// Raw wall-clock minutes between receivedAt and repliedAt
  responseMinutes         Int?
  /// Business-hours-aware minutes (org business hours)
  responseBusinessMinutes Int?
  /// To/Cc addresses that belong to the company's own domains (other than this mailbox itself), lowercase.
  /// Detected at sync time: "who else in our company got this email".
  internalRecipients      String[]    @default([])
  /// The same email (same Message-ID and direction) is also tracked in another mailbox of this company;
  /// this row is the secondary copy. Copies are hidden from "All mailboxes" views and statistics.
  duplicateOfId           String?
  duplicateOf             Message?    @relation("DuplicateCopy", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates              Message[]   @relation("DuplicateCopy")
  /// Outlook Focused Inbox classification from Graph: "focused" | "other"
  inferenceClassification String?
  /// Bulk-mail header signals seen at sync time (headers themselves are not stored), e.g. "list-unsubscribe"
  autoSignals             String[]    @default([])
  /// Why this message is excluded: an ExclusionRule id, or "auto:<signal>" for built-in detection
  excludedBy              String?
  exclusionAction         ExclusionAction?
  /// Outlook on the web link to this message (Graph `webLink`)
  webLink                 String?
  /// Full-text search over subject + participants + cleaned body ('simple' config). Computed in app code from the
  /// plaintext at write time, because the stored body may be encrypted.
  searchVector            Unsupported("tsvector")?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([mailboxId, conversationId])
  @@index([threadId, receivedAt])
  @@index([internetMessageId])
  @@index([duplicateOfId])
  @@index([mailboxId, direction, repliedAt])
  @@index([mailboxId, direction, receivedAt])
  @@index([excludedBy])
  @@index([searchVector], type: Gin)
}

model DigestLog {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sentAt     DateTime     @default(now())
  recipients Json
  content    String
}

/// A very short AI digest of everything sent and received in a rolling window, for one mailbox or all of them.
model PeriodSummary {
  id             String        @id @default(cuid())
  orgId          String
  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// null = all mailboxes of the company
  mailboxId      String?
  mailbox        Mailbox?      @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  /// mailboxId or "all" (nullable columns cannot take part in a unique key)
  scopeKey       String
  period         SummaryPeriod
  periodStart    DateTime
  periodEnd      DateTime
  language       String
  overview       String
  received       Json          @default("[]")
  sent           Json          @default("[]")
  needsAttention Json          @default("[]")
  /// Deterministic counts computed from the database (never from the model)
  stats          Json          @default("{}")
  /// Threads active in the window / included in the prompt
  threadCount    Int           @default(0)
  includedCount  Int           @default(0)
  model          String
  costUsd        Float         @default(0)
  createdBy      String?
  createdAt      DateTime      @default(now())

  @@unique([orgId, scopeKey, period, periodStart])
  @@index([orgId, scopeKey, period, createdAt])
}

/// One row per Claude API call (live or batch), for cost tracking and the daily cap.
model AiUsage {
  id               String       @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  threadId         String?
  model            String
  inputTokens      Int          @default(0)
  outputTokens     Int          @default(0)
  cacheReadTokens  Int          @default(0)
  cacheWriteTokens Int          @default(0)
  costUsd          Float        @default(0)
  batch            Boolean      @default(false)
  error            String?
  purpose          AiPurpose    @default(summary)
  /// Dashboard user who triggered the call (chat questions); null for background jobs
  userId           String?
  createdAt        DateTime     @default(now())

  @@index([orgId, createdAt])
  @@index([threadId])
}

/// One "Ask" conversation. Private to the user who started it.
model ChatSession {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// First question, trimmed
  title     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  turns ChatTurn[]

  @@index([orgId, userId, updatedAt])
}

/// One question and its answer
model ChatTurn {
  id             String      @id @default(cuid())
  sessionId      String
  session        ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question       String
  answerMarkdown String
  /// Validated citations with a snapshot of each source: [{ marker, messageId, threadId, subject, from, to, date, mailbox, webLink }]
  citations      Json        @default("[]")
  found          Boolean     @default(false)
  model          String
  deep           Boolean     @default(false)
  toolCalls      Int         @default(0)
  /// Distinct emails whose content was returned to the model
  emailsRead     Int         @default(0)
  costUsd        Float       @default(0)
  error          String?
  /// Thumbs up / down from the user; null = no feedback
  helpful        Boolean?
  createdAt      DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
}

model AppUser {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  /// Owners see and manage every company (and the Companies page)
  isOwner     Boolean  @default(false)
  /// Deactivated users keep their row (audit history) but cannot sign in
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())

  memberships  Membership[]
  chatSessions ChatSession[]
}

/// A user's role in one company
model Membership {
  id        String       @id @default(cuid())
  userId    String
  user      AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role      UserRole     @default(viewer)
  createdAt DateTime     @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

/// Every dashboard action (who, what, when, before/after)
model AuditLog {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userEmail  String
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  createdAt  DateTime     @default(now())

  @@index([orgId, createdAt])
  @@index([targetType, targetId])
}
